# Conexão com o PostgreSQL (Railway fornece essa URL pronta)
DATABASE_URL="postgresql://postgres:SUA_SENHA@postgres.railway.internal:5432/railway"

# Porta em que a API vai rodar
PORT=4000

# Ambiente
NODE_ENV=development

# Segredo usado para assinar os JWT — gere um valor longo e aleatório em produção
# (nunca use este valor de exemplo em produção)
JWT_SECRET=troque_por_um_valor_aleatorio_bem_grande
JWT_EXPIRES_IN=8h

# Origem permitida para o CORS (URL do frontend)
FRONTEND_URL=http://localhost:3000

# Usados apenas pelo script de seed do primeiro administrador (rode uma vez e depois remova/mude)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=troque_esta_senha

# Opcional — só necessário para o módulo "Analista Financeiro IA" gerar texto.
# Sem isso, o endpoint /api/ai/analysis ainda funciona e devolve os dados reais
# agregados, só não gera a narrativa/recomendações em texto.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

